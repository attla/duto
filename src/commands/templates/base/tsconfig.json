{
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["duto"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "rootDir": "./",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "actions",
    "features",
    "routes",
    "configs",
    "enums",
    "libs",
    "locales",
    "middlewares",
    "models",
    "utils",
    "tests/**/*"
  ],
  "exclude": [
    ".duto",
    "node_modules"
  ]
}